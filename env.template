# ==============================================
# BLOCKCHAIN INDEXING - ENVIRONMENT CONFIG
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# MongoDB connection string
MONGODB_URI=mongodb://admin:admin123@localhost:27017/blockchain_indexing?authSource=admin

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Application port
PORT=3000

# ==============================================
# CHAIN CONFIGURATION (for seeders)
# ==============================================
# Ethereum Sepolia Testnet RPC endpoints
ETH_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
ETH_SEPOLIA_WS_URL=wss://sepolia.infura.io/ws/v3/YOUR_PROJECT_ID

# ==============================================
# BLOCK SCANNING CONFIGURATION
# ==============================================
# Interval between block scans in milliseconds
SCAN_INTERVAL_MS=5000                        # 5 seconds (default)

# Number of blocks to scan per batch
BLOCKS_PER_SCAN=100

# RPC call retry settings
RPC_MAX_RETRIES=3                            # Maximum number of retries for RPC calls
RPC_RETRY_DELAY=1000                         # Delay between retries in milliseconds

# Contract refresh settings
# Interval for refreshing contract and chain configs from database (milliseconds)
CONTRACT_REFRESH_INTERVAL=30000              # 30 seconds (default)

# ==============================================
# CACHE CONFIGURATION
# ==============================================
# Receipt cache: stores transaction receipts to avoid duplicate RPC calls
RECEIPT_CACHE_MAX_SIZE=3000                  # Maximum receipt cache entries before cleanup
RECEIPT_CACHE_KEEP_SIZE=1500                 # Number of entries to keep after cleanup (latest entries)

# Block cache: stores block data for timestamps
BLOCK_CACHE_MAX_SIZE=2000                    # Maximum block cache entries before cleanup
BLOCK_CACHE_KEEP_SIZE=1000                   # Number of entries to keep after cleanup (latest entries)
